# =============================================================================
#  Cloud Suite — запуск на «белом» IP без домена и хостинга (template)
#  ---------------------------------------------------------------------------
#  1. cp .env.ip.example .env.ip
#  2. edit PUBLIC_IP (публичный IPv4 сервера) и при необходимости порты
#  3. make ip-env          # заполняет пустые секреты
#  4. make ip-up && make ip-configure && make ip-check
#
#  Режим для сервера с публичным IP и БЕЗ домена: ни DNS, ни Let's Encrypt,
#  ни NPM не используются, вход — http://PUBLIC_IP/ (см. docs/14-ip-run.md).
#
#  NEVER commit the resulting .env.ip — it is git-ignored on purpose.
#  Empty values below are filled by scripts/generate-secrets.sh.
# =============================================================================

# --- Project ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=cloudsuite-ip
# Timezone of the organisation (audit log timestamps, cron, UI)
TZ=Asia/Novosibirsk

# --- Адресация: белый IP без домена ----------------------------------------
# Публичный IPv4 сервера — именно его увидят браузеры: http://PUBLIC_IP/...
# Должен быть глобально маршрутизируемым (private/loopback отклоняются:
# см. require-ip-env в Makefile).
PUBLIC_IP=203.0.113.10
# Интерфейс, на котором публикуются порты.
#   0.0.0.0   — все интерфейсы (обычный вариант для VPS с белым IP);
#   127.0.0.1 — только loopback, если TLS терминируется внешним прокси.
IP_BIND=0.0.0.0
# Порт Nextcloud (80 = браузеры открывают http://PUBLIC_IP/ без порта).
IP_HTTP_PORT=80
# Порт ONLYOFFICE Docs для браузера (http://PUBLIC_IP:8081/).
IP_OFFICE_PORT=8081
# Адрес Nextcloud без схемы: PUBLIC_IP, а если IP_HTTP_PORT != 80 — с портом.
# Образ Nextcloud каждый старт пересобирает reverse-proxy.config.php из
# OVERWRITEHOST, поэтому PUBLIC_HOST обязан совпадать с PUBLIC_BASE_URL.
PUBLIC_HOST=203.0.113.10
# Полный адрес Nextcloud. Если IP_HTTP_PORT != 80 — обязательно с портом,
# например http://203.0.113.10:8080. По нему configure задаёт overwritehost.
PUBLIC_BASE_URL=http://203.0.113.10
# Адрес ONLYOFFICE Docs для браузера (изнутри стека — http://onlyoffice/).
DOCUMENT_SERVER_URL=http://203.0.113.10:8081/
# Статический адрес web в сети edge: нужен, чтобы маршрут callback'ов
# ONLYOFFICE (скрипт ip-callback-route.sh) знал, куда перенаправлять
# PUBLIC_IP:IP_HTTP_PORT внутри docker-сети.
IP_WEB_IP=172.28.10.12
# Образ одноразового контейнера для правила callback-маршрута
# (нужен в воздушно-закрытых сетях: заранее docker pull <образ>)
# IP_ROUTE_IMAGE=alpine:3.20
# Публичный адрес Nextcloud — тот же IP (домена нет).
CLOUD_DOMAIN=203.0.113.10
# Служебное имя ONLYOFFICE: нужно только для extra_hosts/nginx и НЕ открывается
# в браузере (редактор доступен по http://PUBLIC_IP:IP_OFFICE_PORT/).
# Оно обязано отличаться от CLOUD_DOMAIN: compose не принимает два одинаковых
# extra_hosts-пункта ("extra_hosts must be a mapping").
OFFICE_DOMAIN=office.internal
NEXTCLOUD_TRUSTED_DOMAINS=203.0.113.10 localhost 127.0.0.1 web
# ACME/Let's Encrypt в этом режиме не используются (нет домена).
ACME_EMAIL=admin@example.invalid
HTTP_PORT=80
HTTPS_PORT=443

# NPM не стартует (профиль edge), но переменные нужны compose-интерполяции.
NPM_ADMIN_BIND=127.0.0.1
NPM_ADMIN_PORT=8181
NPM_ADMIN_EMAIL=admin@example.invalid
NPM_VERSION=2.16.0
NPM_ADMIN_PASSWORD=

# --- Nextcloud --------------------------------------------------------------
NEXTCLOUD_VERSION=35.0.2-fpm
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
PHP_MEMORY_LIMIT=1G
# Must match nginx client_max_body_size; keep nginx/PHP/Nextcloud in sync.
PHP_UPLOAD_LIMIT=10G
CRON_INTERVAL_SECONDS=300

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_VERSION=17.11-alpine
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# --- Cache / locking (Redis) ------------------------------------------------
REDIS_VERSION=8.4.7-alpine
REDIS_PASSWORD=

# --- S3 object storage (SeaweedFS) -----------------------------------------
SEAWEEDFS_VERSION=latest
S3_BUCKET=nextcloud
S3_REGION=us-east-1
S3_USER=nextcloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
# Must stay <= 30720: SeaweedFS master refuses larger values at startup.
SEAWEEDFS_VOLUME_SIZE_MB=30720
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333

# --- ONLYOFFICE Docs --------------------------------------------------------
ONLYOFFICE_VERSION=8.3.3
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_IN_BODY=true

# --- Versioning / retention -------------------------------------------------
VERSIONS_MAX=20
VERSIONS_RETENTION_DAYS=30
TRASH_RETENTION_DAYS=30

# --- Backups ----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_PASSPHRASE=
BACKUP_OFFSITE_REMOTE=

# --- Mail (invites, share notifications, password resets) -------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cloud@example.invalid
MAIL_DOMAIN=example.invalid

# --- Networking / proxy -----------------------------------------------------
# Публичный IP не проксируется NPM: web слушает порты напрямую, поэтому
# PROXY_IP равен адресу web (нужен только для extra_hosts/TRUSTED_PROXIES).
PROXY_IP=172.28.10.12
TRUSTED_PROXIES=172.28.10.0/24
NGINX_VERSION=1.29-alpine

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
