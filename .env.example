# =============================================================================
#  Cloud Suite — production environment template
#  ---------------------------------------------------------------------------
#  1. cp .env.example .env
#  2. edit CLOUD_DOMAIN / OFFICE_DOMAIN / ACME_EMAIL and SMTP settings
#  3. ./scripts/generate-secrets.sh      # fills every empty secret below
#  4. make bootstrap && make up
#
#  NEVER commit the resulting .env — it is git-ignored on purpose.
#  Empty values below are filled by scripts/generate-secrets.sh.
# =============================================================================

# --- Project ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=cloudsuite
# Timezone of the organisation (audit log timestamps, cron, UI)
TZ=Asia/Novosibirsk

# --- Public edge / domains --------------------------------------------------
# Both names must resolve (A/AAAA) to this server before the first start.
CLOUD_DOMAIN=cloud.example.com
OFFICE_DOMAIN=office.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Nginx Proxy Manager GUI. Bound to loopback by default — reach it through an
# SSH tunnel:  ssh -L 8181:127.0.0.1:8181 root@server  ->  http://127.0.0.1:8181
NPM_ADMIN_BIND=127.0.0.1
NPM_ADMIN_PORT=8181
NPM_ADMIN_EMAIL=admin@example.com
# Версия Nginx Proxy Manager (обновляйте осознанно: make update)
NPM_VERSION=2.16.0
# First NPM login password (GUI account). Change it after the first login.
NPM_ADMIN_PASSWORD=

# --- Nextcloud --------------------------------------------------------------
NEXTCLOUD_VERSION=35.0.2-fpm
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com office.example.com web
PHP_MEMORY_LIMIT=1G
# Must match nginx client_max_body_size; keep nginx/PHP/Nextcloud in sync.
PHP_UPLOAD_LIMIT=10G
CRON_INTERVAL_SECONDS=300

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_VERSION=17.11-alpine
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# --- Cache / locking (Redis) ------------------------------------------------
REDIS_VERSION=8.4.7-alpine
REDIS_PASSWORD=

# --- S3 object storage (SeaweedFS) -----------------------------------------
SEAWEEDFS_VERSION=latest
S3_BUCKET=nextcloud
S3_REGION=us-east-1
# Credentials used by Nextcloud as the S3 client (S3_ACCESS_KEY/S3_SECRET_KEY).
# The identity is applied to SeaweedFS by the one-shot "s3-init" service via
# "weed shell s3.configure -apply" on every start (idempotent). There is no
# config/seaweedfs/s3.json any more: SeaweedFS 4.x ignores -s3.config in
# "weed server", so the credentials live only in .env.
S3_USER=nextcloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
# Must stay <= 30720: SeaweedFS master refuses larger values at startup
# ("master.volumeSizeLimitMB should not exceed 30720").
SEAWEEDFS_VOLUME_SIZE_MB=30720
# Admin-only, bound to loopback (filer UI / master status).
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333

# --- ONLYOFFICE Docs --------------------------------------------------------
ONLYOFFICE_VERSION=8.3.3
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_IN_BODY=true

# --- Versioning / retention -------------------------------------------------
# Maximum number of file versions kept per file (files_versions pruner).
VERSIONS_MAX=20
# Time-based safety net of the native app (days); the pruner enforces the count.
VERSIONS_RETENTION_DAYS=30
# Days a deleted file stays in the trash before the cleanup job removes it.
TRASH_RETENTION_DAYS=30

# --- Backups ----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_PASSPHRASE=
# Optional off-site copy (rclone remote name configured on the host, e.g. "yandex")
BACKUP_OFFSITE_REMOTE=

# --- Mail (invites, share notifications, password resets) -------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cloud@example.com
# Домен для MAIL_DOMAIN (Nextcloud использует его для адреса отправителя)
MAIL_DOMAIN=example.com

# --- Admin-only overlay (docker-compose.admin.yml, trusted LAN only) --------
# make admin-up publishes these on the LAN; leave commented out for the default
# loopback-only binding. NEVER expose them to the internet.
# NPM_ADMIN_BIND_LAN=127.0.0.1
# SEAWEEDFS_ADMIN_BIND_LAN=127.0.0.1

# --- Observability overlay (docker-compose.observability.yml) ----------------
# Optional Loki + Promtail stack; enable with --profile observability.
# LOKI_VERSION=3.5.1
# PROMTAIL_VERSION=3.5.1
# LOKI_BIND=127.0.0.1
# LOKI_PORT=3100
# LOKI_RETENTION=720h

# --- Networking / proxy -----------------------------------------------------
# Fixed addresses from the compose networks; trusted by Nextcloud.
PROXY_IP=172.28.10.10
TRUSTED_PROXIES=172.28.10.0/24
NGINX_VERSION=1.29-alpine

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
