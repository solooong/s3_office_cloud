# =============================================================================
#  Cloud Suite — окружение ЛОКАЛЬНОГО запуска (без домена, без TLS)
#  ---------------------------------------------------------------------------
#  Быстрый старт:
#      make local-env     # копирует этот файл в .env.local и заполняет секреты
#      make local-up
#      make local-configure
#      make local-check   # http://cloud.local:8080
#
#  Это отдельный compose-проект (cloudsuite-local) со своими томами: локальный
#  стек не пересекается с продовым (.env) и его можно удалить целиком
#  "make local-down VOLUMES=1".
#
#  .env.local в git не попадает. Секреты заполняет scripts/generate-secrets.sh.
# =============================================================================

# --- Project ----------------------------------------------------------------
# Отдельный проект: не мешает продовому стеку и его томам.
COMPOSE_PROJECT_NAME=cloudsuite-local
TZ=Asia/Novosibirsk

# --- Local endpoints (без домена) -------------------------------------------
# Локальные имена НЕ из зоны *.localhost: браузеры и контейнеры трактуют
# *.localhost как loopback жёстко, игнорируя /etc/hosts, из-за чего ONLYOFFICE
# не смог бы достучаться до Nextcloud по адресу callback'а. Эти имена
# добавляются в hosts один раз: make local-hosts (см. docs/13-local-run.md).
LOCAL_HOST=cloud.local
LOCAL_OFFICE_HOST=office.local
LOCAL_HTTP_PORT=8080
LOCAL_OFFICE_PORT=8081
# Полный локальный адрес Nextcloud (используется configure-nextcloud.sh).
PUBLIC_BASE_URL=http://cloud.local:8080
# Адрес ONLYOFFICE Docs для браузера (изнутри стека — http://onlyoffice/).
DOCUMENT_SERVER_URL=http://cloud.local:8081/

# --- Домены формально нужны compose, но локально не используются -------------
CLOUD_DOMAIN=cloud.local
OFFICE_DOMAIN=office.local
ACME_EMAIL=admin@cloud.local
HTTP_PORT=80
HTTPS_PORT=443

# --- Nginx Proxy Manager (в локальном профиле НЕ запускается) ---------------
# Переменные обязательны для базового compose, но сервис proxy отключён
# профилем "edge" в docker-compose.local.yml.
NPM_ADMIN_BIND=127.0.0.1
NPM_ADMIN_PORT=8181
NPM_ADMIN_EMAIL=admin@cloud.local
NPM_ADMIN_PASSWORD=
NPM_VERSION=2.16.0

# --- Nextcloud --------------------------------------------------------------
NEXTCLOUD_VERSION=35.0.2-fpm
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
# Локальные имена + docker-имя web (для серверных запросов и /status.php).
NEXTCLOUD_TRUSTED_DOMAINS=cloud.local office.local localhost 127.0.0.1 web
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G
CRON_INTERVAL_SECONDS=300

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_VERSION=17.11-alpine
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# --- Cache / locking (Redis) ------------------------------------------------
REDIS_VERSION=8.4.7-alpine
REDIS_PASSWORD=

# --- S3 object storage (SeaweedFS) -----------------------------------------
SEAWEEDFS_VERSION=latest
S3_BUCKET=nextcloud
S3_REGION=us-east-1
S3_USER=nextcloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
SEAWEEDFS_VOLUME_SIZE_MB=30720
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333

# --- ONLYOFFICE Docs --------------------------------------------------------
ONLYOFFICE_VERSION=8.3.3
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_IN_BODY=true

# --- Versioning / retention -------------------------------------------------
VERSIONS_MAX=20
VERSIONS_RETENTION_DAYS=30
TRASH_RETENTION_DAYS=30

# --- Backups ----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_PASSPHRASE=
BACKUP_OFFSITE_REMOTE=

# --- Mail (локально не нужна) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cloud@cloud.local
MAIL_DOMAIN=cloud.local

# --- Networking / proxy -----------------------------------------------------
# LOCAL_WEB_IP — статический адрес web в сети edge (docker-compose.local.yml).
# PROXY_IP задан тем же значением: extra_hosts (${CLOUD_DOMAIN}:${PROXY_IP}) резолвит
# cloud.local в web, поэтому серверные callback'и ONLYOFFICE доходят до
# Nextcloud.
LOCAL_WEB_IP=172.28.10.11
PROXY_IP=172.28.10.11
TRUSTED_PROXIES=172.28.10.0/24
NGINX_VERSION=1.29-alpine

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
